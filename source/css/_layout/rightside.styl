/*日间夜间模式侧边栏透明模糊*/
[data-theme=light] #rightside-container 
  background: rgba(229,232,241,0.8)!important;
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);

[data-theme=dark] #rightside-container 
  background: rgba(46,45,44,.8)!important;
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px)
  
  #rightside-time
    color: var(--btn-color)


// 新增包裹容器样式
#rightside-container
  position: fixed
  right: 10px
  bottom: $rightside-bottom
  z-index: 100
  background: var(--anzhiyu-post-blockquote-bg);
  padding: 12px 6px
  border-radius: 25px 25px 25px 25px
  box-shadow: var(--anzhiyu-shadow-border)
  transition: all .5s
  display: flex
  flex-direction: column
  align-items: center

  #rightside
    position: relative
    right: 0
    opacity: 1
    z-index: 101
    margin-bottom: 10px // 与时间区域的间距

  #rightside-time
    display: flex
    flex-direction: column
    align-items: center
    justify-content: center
    font-size: 12px
    color: var(--btn-bg)
    line-height: 1.4
    padding-top: 5px
    border-top: none
    width: 100%
    
    #rightside-hours
      font-weight: bold
      font-size: 14px
    
    #rightside-ampm
      text-transform: uppercase
      font-size: 10px

#rightside
  i
    font-size: 1rem

  #rightside-config-hide
    height: 0
    opacity: 0
    transition: transform .4s
    transform: translate(45px, 0)

    &.show
      height: auto
      opacity: 1
      transform: translate(0, 0)

    &.status
      height: auto
      opacity: 1

  & > div
    & > button,
    & > a
      display: block
      margin-bottom: 10px
      width: w = 40px
      height: w
      border-radius: 100% !important
      background-color: var(--btn-bg)
      color: var(--btn-color)
      text-align: center
      font-size: 16px
      line-height: w
      box-shadow: var(--anzhiyu-shadow-border)

      &:hover
        background-color: var(--btn-hover-color)

  #mobile-toc-button
    display: none

    +maxWidth900()
      display: block

  +maxWidth900()
    #hide-aside-btn
      display: none

  +maxWidth768()
    #switch-commentBarrage
      display: none